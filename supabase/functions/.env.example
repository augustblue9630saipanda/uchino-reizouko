# TEST server environment only. Never put a real secret in this example or commit .env.
# Supabase hosted functions supply SUPABASE_URL and SUPABASE_ANON_KEY automatically.
GEMINI_API_KEY=replace_in_test_server_secrets_only
# Use a model enabled for your Google project that supports JSON structured outputs.
GEMINI_MODEL=gemini-2.5-flash
DINNER_ALLOWED_ORIGINS=http://localhost:8000
